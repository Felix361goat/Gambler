[Unit]
Description=Run the paper-trading harness daily after market close

[Timer]
# 23:30 local time daily; adjust to your timezone / market close.
OnCalendar=*-*-* 23:30:00
# Persistent=true re-runs a missed session after a VPS reboot/downtime
# (cron silently drops missed jobs — this is why we use a systemd timer).
Persistent=true

[Install]
WantedBy=timers.target
